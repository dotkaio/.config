#!/usr/bin/env bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}Starting cleanup and push for ~/Developer${NC}\n"

# Process each directory in ~/Developer
for dir in ~/Developer/*/; do
  dir=${dir%/}
  dirname=$(basename "$dir")
  
  echo -e "\n${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${YELLOW}Processing: $dirname${NC}"
  echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  
  # Check if it's a git repo
  if [ -d "$dir/.git" ]; then
    cd "$dir"
    
    # Check git status
    if [ -n "$(git status --porcelain)" ]; then
      echo -e "${BLUE}📝 Changes detected, creating commit...${NC}"
      
      # Get status summary
      added=$(git status --porcelain | grep -c "^A" || true)
      modified=$(git status --porcelain | grep -c "^.M" || true)
      deleted=$(git status --porcelain | grep -c "^.D" || true)
      untracked=$(git status --porcelain | grep -c "^??" || true)
      
      # Build commit message
      msg="Update: "
      parts=()
      [ $added -gt 0 ] && parts+=("$added added")
      [ $modified -gt 0 ] && parts+=("$modified modified")
      [ $deleted -gt 0 ] && parts+=("$deleted deleted")
      [ $untracked -gt 0 ] && parts+=("$untracked new")
      
      commit_msg="$msg$(IFS=', '; echo "${parts[*]}")"
      
      echo -e "${GREEN}Commit message: $commit_msg${NC}"
      
      git add -A
      git commit -m "$commit_msg" || echo -e "${RED}Commit failed${NC}"
      
      echo -e "${BLUE}Pushing to remote...${NC}"
      git push 2>&1 || echo -e "${YELLOW}⚠ Push skipped (no remote configured)${NC}"
      
    else
      echo -e "${GREEN}✓ No changes to commit${NC}"
    fi
  else
    echo -e "${YELLOW}⊘ Not a git repository${NC}"
  fi
  
  # Clean up non-essential files
  echo -e "\n${BLUE}🧹 Cleaning up build artifacts...${NC}"
  
  cleaned=0
  
  # Function to force remove directory
  force_remove() {
    if [ -d "$1" ]; then
      echo "  Removing $(basename "$1")..."
      chmod -R +w "$1" 2>/dev/null || true
      rm -rf "$1" 2>/dev/null || true
      [ ! -d "$1" ] && cleaned=$((cleaned + 1))
    fi
  }
  
  # Remove all non-essential directories
  force_remove "$dir/node_modules"
  force_remove "$dir/.next"
  force_remove "$dir/.vercel"
  force_remove "$dir/build"
  force_remove "$dir/dist"
  force_remove "$dir/.build"
  force_remove "$dir/out"
  force_remove "$dir/.turbo"
  force_remove "$dir/coverage"
  force_remove "$dir/.cache"
  force_remove "$dir/tmp"
  force_remove "$dir/temp"
  force_remove "$dir/.tmp"
  force_remove "$dir/.parcel-cache"
  force_remove "$dir/.vite"
  
  if [ $cleaned -eq 0 ]; then
    echo -e "${GREEN}  ✓ No artifacts to clean${NC}"
  else
    echo -e "${GREEN}  ✓ Cleaned $cleaned directories${NC}"
  fi
  
done

echo -e "\n${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Cleanup complete!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
